# Copy this file to .env and fill it in. Never commit .env.

# Model to use, in langchain's "provider:model" form.
# Check your provider's docs for the current model names.
AGENT_MODEL=anthropic:<model name>

# Key for the provider you picked above (only one is needed).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Only needed for the "github" command. Use a fine-grained token limited to
# ONE repo, with read and write on: Contents, Issues, Pull requests.
GITHUB_TOKEN=

# Optional: tracing with Langfuse.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: limits and prices (USD per one million tokens) for cost numbers.
# AGENT_MAX_ATTEMPTS=3
# AGENT_MAX_TOKENS_PER_TICKET=300000
# AGENT_PRICE_IN=
# AGENT_PRICE_OUT=
